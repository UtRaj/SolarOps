# ==============================================================================
# SolarOps Platform Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=3000
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Transactional Database
POSTGRES_USER=solarops
POSTGRES_PASSWORD=solarops_secret_change_in_prod
POSTGRES_DB=solarops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://solarops:solarops_secret_change_in_prod@localhost:5432/solarops_db

# TimescaleDB High-Volume Telemetry Database
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=solarops_telemetry
TIMESCALE_URL=postgresql+asyncpg://solarops:solarops_secret_change_in_prod@localhost:5432/solarops_telemetry

# Redis In-Memory Cache & Distributed Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# NATS JetStream Durable Event Broker
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=SOLAROPS_EVENTS
NATS_SUBJECT_PREFIX=solarops.events

# AI Service Credentials (Optional, Server-side Only)
GEMINI_API_KEY=
